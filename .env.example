# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo ".env" real a GitHub (ya está protegido en .gitignore).

# --- Base de datos (obligatorio) ---
# Cadena de conexión de tu proyecto Postgres en Supabase.
# La encuentras en: Supabase > Project Settings > Database > Connection string (modo "URI").
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- Autenticación (obligatorio) ---
# Cualquier texto largo y aleatorio, usado para firmar las sesiones de login.
# Genera uno nuevo, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# --- Usuario administrador inicial (opcional) ---
# Se crea automáticamente la primera vez que arranca el servidor, si no
# existe ningún usuario todavía. Cambia la contraseña después del primer login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar123
ADMIN_FULL_NAME=Administrador

# --- Servidor (opcional) ---
PORT=3000
NODE_ENV=development
